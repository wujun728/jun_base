<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.template.system.mapper.SysLoanHeaderMapper">
    
    <resultMap type="SysLoanHeader" id="SysLoanHeaderResult">
        <result property="id"    column="id"    />
        <result property="code"    column="code"    />
        <result property="borrower"    column="borrower"    />
        <result property="loanDate"    column="loan_date"    />
        <result property="operator"    column="operator"    />
        <result property="approver"    column="approver"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectSysLoanHeaderVo">
        select id, code, borrower, loan_date, operator, approver, create_by, create_time, update_by, update_time, remark from sys_loan_header
    </sql>

    <select id="selectSysLoanHeaderList" parameterType="SysLoanHeader" resultMap="SysLoanHeaderResult">
        <include refid="selectSysLoanHeaderVo"/>
        <where>  
            <if test="code != null  and code != ''"> and code = #{code}</if>
            <if test="borrower != null  and borrower != ''"> and borrower = #{borrower}</if>
            <if test="loanDate != null "> and loan_date = #{loanDate}</if>
            <if test="operator != null  and operator != ''"> and operator = #{operator}</if>
            <if test="approver != null  and approver != ''"> and approver = #{approver}</if>
        </where>
    </select>
    
    <select id="selectSysLoanHeaderById" parameterType="Long" resultMap="SysLoanHeaderResult">
        <include refid="selectSysLoanHeaderVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertSysLoanHeader" parameterType="SysLoanHeader" useGeneratedKeys="true" keyProperty="id">
        insert into sys_loan_header
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="code != null and code != ''">code,</if>
            <if test="borrower != null and borrower != ''">borrower,</if>
            <if test="loanDate != null">loan_date,</if>
            <if test="operator != null">operator,</if>
            <if test="approver != null">approver,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="code != null and code != ''">#{code},</if>
            <if test="borrower != null and borrower != ''">#{borrower},</if>
            <if test="loanDate != null">#{loanDate},</if>
            <if test="operator != null">#{operator},</if>
            <if test="approver != null">#{approver},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateSysLoanHeader" parameterType="SysLoanHeader">
        update sys_loan_header
        <trim prefix="SET" suffixOverrides=",">
            <if test="code != null and code != ''">code = #{code},</if>
            <if test="borrower != null and borrower != ''">borrower = #{borrower},</if>
            <if test="loanDate != null">loan_date = #{loanDate},</if>
            <if test="operator != null">operator = #{operator},</if>
            <if test="approver != null">approver = #{approver},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteSysLoanHeaderById" parameterType="Long">
        delete from sys_loan_header where id = #{id}
    </delete>

    <delete id="deleteSysLoanHeaderByIds" parameterType="String">
        delete from sys_loan_header where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>