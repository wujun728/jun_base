<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.template.system.mapper.SysPoLineMapper">
    
    <resultMap type="SysPoLine" id="SysPoLineResult">
        <result property="id"    column="id"    />
        <result property="poId"    column="po_id"    />
        <result property="lineNo"    column="line_no"    />
        <result property="productId"    column="product_id"    />
        <result property="productCode"    column="product_code"    />
        <result property="productName"    column="product_name"    />
        <result property="shortName"    column="short_name"    />
        <result property="spec"    column="spec"    />
        <result property="unit"    column="unit"    />
        <result property="qtyOrdered"    column="qty_ordered"    />
        <result property="price"    column="price"    />
        <result property="manufacturer"    column="manufacturer"    />
        <result property="warehouseId"    column="warehouse_id"    />
        <result property="qtyPurchased"    column="qty_purchased"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectSysPoLineVo">
        select id, po_id, line_no, product_id, product_code, product_name, short_name, spec, unit, qty_ordered, price, manufacturer, warehouse_id, qty_purchased, create_by, create_time, update_by, update_time, remark from sys_po_line
    </sql>

    <select id="selectSysPoLineList" parameterType="SysPoLine" resultMap="SysPoLineResult">
        <include refid="selectSysPoLineVo"/>
        <where>  
            <if test="poId != null "> and po_id = #{poId}</if>
            <if test="lineNo != null "> and line_no = #{lineNo}</if>
            <if test="productId != null "> and product_id = #{productId}</if>
            <if test="productCode != null  and productCode != ''"> and product_code = #{productCode}</if>
            <if test="productName != null  and productName != ''"> and product_name like concat('%', #{productName}, '%')</if>
            <if test="shortName != null  and shortName != ''"> and short_name like concat('%', #{shortName}, '%')</if>
            <if test="spec != null  and spec != ''"> and spec = #{spec}</if>
            <if test="unit != null  and unit != ''"> and unit = #{unit}</if>
            <if test="qtyOrdered != null "> and qty_ordered = #{qtyOrdered}</if>
            <if test="price != null "> and price = #{price}</if>
            <if test="manufacturer != null  and manufacturer != ''"> and manufacturer = #{manufacturer}</if>
            <if test="warehouseId != null "> and warehouse_id = #{warehouseId}</if>
            <if test="qtyPurchased != null "> and qty_purchased = #{qtyPurchased}</if>
        </where>
    </select>
    
    <select id="selectSysPoLineById" parameterType="Long" resultMap="SysPoLineResult">
        <include refid="selectSysPoLineVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertSysPoLine" parameterType="SysPoLine" useGeneratedKeys="true" keyProperty="id">
        insert into sys_po_line
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="poId != null">po_id,</if>
            <if test="lineNo != null">line_no,</if>
            <if test="productId != null">product_id,</if>
            <if test="productCode != null">product_code,</if>
            <if test="productName != null">product_name,</if>
            <if test="shortName != null">short_name,</if>
            <if test="spec != null">spec,</if>
            <if test="unit != null">unit,</if>
            <if test="qtyOrdered != null">qty_ordered,</if>
            <if test="price != null">price,</if>
            <if test="manufacturer != null">manufacturer,</if>
            <if test="warehouseId != null">warehouse_id,</if>
            <if test="qtyPurchased != null">qty_purchased,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="poId != null">#{poId},</if>
            <if test="lineNo != null">#{lineNo},</if>
            <if test="productId != null">#{productId},</if>
            <if test="productCode != null">#{productCode},</if>
            <if test="productName != null">#{productName},</if>
            <if test="shortName != null">#{shortName},</if>
            <if test="spec != null">#{spec},</if>
            <if test="unit != null">#{unit},</if>
            <if test="qtyOrdered != null">#{qtyOrdered},</if>
            <if test="price != null">#{price},</if>
            <if test="manufacturer != null">#{manufacturer},</if>
            <if test="warehouseId != null">#{warehouseId},</if>
            <if test="qtyPurchased != null">#{qtyPurchased},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateSysPoLine" parameterType="SysPoLine">
        update sys_po_line
        <trim prefix="SET" suffixOverrides=",">
            <if test="poId != null">po_id = #{poId},</if>
            <if test="lineNo != null">line_no = #{lineNo},</if>
            <if test="productId != null">product_id = #{productId},</if>
            <if test="productCode != null">product_code = #{productCode},</if>
            <if test="productName != null">product_name = #{productName},</if>
            <if test="shortName != null">short_name = #{shortName},</if>
            <if test="spec != null">spec = #{spec},</if>
            <if test="unit != null">unit = #{unit},</if>
            <if test="qtyOrdered != null">qty_ordered = #{qtyOrdered},</if>
            <if test="price != null">price = #{price},</if>
            <if test="manufacturer != null">manufacturer = #{manufacturer},</if>
            <if test="warehouseId != null">warehouse_id = #{warehouseId},</if>
            <if test="qtyPurchased != null">qty_purchased = #{qtyPurchased},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteSysPoLineById" parameterType="Long">
        delete from sys_po_line where id = #{id}
    </delete>

    <delete id="deleteSysPoLineByIds" parameterType="String">
        delete from sys_po_line where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>