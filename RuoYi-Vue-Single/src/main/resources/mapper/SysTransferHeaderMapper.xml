<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.template.system.mapper.SysTransferHeaderMapper">
    
    <resultMap type="SysTransferHeader" id="SysTransferHeaderResult">
        <result property="id"    column="id"    />
        <result property="code"    column="code"    />
        <result property="dstWarehouseId"    column="dst_warehouse_id"    />
        <result property="srcWarehouseId"    column="src_warehouse_id"    />
        <result property="transferDate"    column="transfer_date"    />
        <result property="transferBy"    column="transfer_by"    />
        <result property="operator"    column="operator"    />
        <result property="approver"    column="approver"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectSysTransferHeaderVo">
        select id, code, dst_warehouse_id, src_warehouse_id, transfer_date, transfer_by, operator, approver, create_by, create_time, update_by, update_time, remark from sys_transfer_header
    </sql>

    <select id="selectSysTransferHeaderList" parameterType="SysTransferHeader" resultMap="SysTransferHeaderResult">
        <include refid="selectSysTransferHeaderVo"/>
        <where>  
            <if test="code != null  and code != ''"> and code = #{code}</if>
            <if test="dstWarehouseId != null "> and dst_warehouse_id = #{dstWarehouseId}</if>
            <if test="srcWarehouseId != null "> and src_warehouse_id = #{srcWarehouseId}</if>
            <if test="transferDate != null "> and transfer_date = #{transferDate}</if>
            <if test="transferBy != null  and transferBy != ''"> and transfer_by = #{transferBy}</if>
            <if test="operator != null  and operator != ''"> and operator = #{operator}</if>
            <if test="approver != null  and approver != ''"> and approver = #{approver}</if>
        </where>
    </select>
    
    <select id="selectSysTransferHeaderById" parameterType="Long" resultMap="SysTransferHeaderResult">
        <include refid="selectSysTransferHeaderVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertSysTransferHeader" parameterType="SysTransferHeader" useGeneratedKeys="true" keyProperty="id">
        insert into sys_transfer_header
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="code != null and code != ''">code,</if>
            <if test="dstWarehouseId != null">dst_warehouse_id,</if>
            <if test="srcWarehouseId != null">src_warehouse_id,</if>
            <if test="transferDate != null">transfer_date,</if>
            <if test="transferBy != null">transfer_by,</if>
            <if test="operator != null">operator,</if>
            <if test="approver != null">approver,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="code != null and code != ''">#{code},</if>
            <if test="dstWarehouseId != null">#{dstWarehouseId},</if>
            <if test="srcWarehouseId != null">#{srcWarehouseId},</if>
            <if test="transferDate != null">#{transferDate},</if>
            <if test="transferBy != null">#{transferBy},</if>
            <if test="operator != null">#{operator},</if>
            <if test="approver != null">#{approver},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateSysTransferHeader" parameterType="SysTransferHeader">
        update sys_transfer_header
        <trim prefix="SET" suffixOverrides=",">
            <if test="code != null and code != ''">code = #{code},</if>
            <if test="dstWarehouseId != null">dst_warehouse_id = #{dstWarehouseId},</if>
            <if test="srcWarehouseId != null">src_warehouse_id = #{srcWarehouseId},</if>
            <if test="transferDate != null">transfer_date = #{transferDate},</if>
            <if test="transferBy != null">transfer_by = #{transferBy},</if>
            <if test="operator != null">operator = #{operator},</if>
            <if test="approver != null">approver = #{approver},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteSysTransferHeaderById" parameterType="Long">
        delete from sys_transfer_header where id = #{id}
    </delete>

    <delete id="deleteSysTransferHeaderByIds" parameterType="String">
        delete from sys_transfer_header where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>