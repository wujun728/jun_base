<mapper namespace="com.template.system.mapper.SysStockCountHeaderMapper">
    
    <resultMap type="SysStockCountHeader" id="SysStockCountHeaderResult">
        <result property="id"    column="id"    />
        <result property="code"    column="code"    />
        <result property="countDate"    column="count_date"    />
        <result property="salesman"    column="salesman"    />
        <result property="operator"    column="operator"    />
        <result property="approver"    column="approver"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectSysStockCountHeaderVo">
        select id, code, count_date, salesman, operator, approver, create_by, create_time, update_by, update_time, remark from sys_stock_count_header
    </sql>

    <select id="selectSysStockCountHeaderList" parameterType="SysStockCountHeader" resultMap="SysStockCountHeaderResult">
        <include refid="selectSysStockCountHeaderVo"/>
        <where>  
            <if test="code != null  and code != ''"> and code = #{code}</if>
            <if test="countDate != null "> and count_date = #{countDate}</if>
            <if test="salesman != null  and salesman != ''"> and salesman = #{salesman}</if>
            <if test="operator != null  and operator != ''"> and operator = #{operator}</if>
            <if test="approver != null  and approver != ''"> and approver = #{approver}</if>
        </where>
    </select>
    
    <select id="selectSysStockCountHeaderById" parameterType="Long" resultMap="SysStockCountHeaderResult">
        <include refid="selectSysStockCountHeaderVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertSysStockCountHeader" parameterType="SysStockCountHeader" useGeneratedKeys="true" keyProperty="id">
        insert into sys_stock_count_header
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="code != null and code != ''">code,</if>
            <if test="countDate != null">count_date,</if>
            <if test="salesman != null">salesman,</if>
            <if test="operator != null">operator,</if>
            <if test="approver != null">approver,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="code != null and code != ''">#{code},</if>
            <if test="countDate != null">#{countDate},</if>
            <if test="salesman != null">#{salesman},</if>
            <if test="operator != null">#{operator},</if>
            <if test="approver != null">#{approver},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateSysStockCountHeader" parameterType="SysStockCountHeader">
        update sys_stock_count_header
        <trim prefix="SET" suffixOverrides=",">
            <if test="code != null and code != ''">code = #{code},</if>
            <if test="countDate != null">count_date = #{countDate},</if>
            <if test="salesman != null">salesman = #{salesman},</if>
            <if test="operator != null">operator = #{operator},</if>
            <if test="approver != null">approver = #{approver},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteSysStockCountHeaderById" parameterType="Long">
        delete from sys_stock_count_header where id = #{id}
    </delete>

    <delete id="deleteSysStockCountHeaderByIds" parameterType="String">
        delete from sys_stock_count_header where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>