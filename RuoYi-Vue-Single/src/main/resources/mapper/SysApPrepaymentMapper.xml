<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.template.system.mapper.SysApPrepaymentMapper">
    
    <resultMap type="SysApPrepayment" id="SysApPrepaymentResult">
        <result property="id"    column="id"    />
        <result property="code"    column="code"    />
        <result property="originCode"    column="origin_code"    />
        <result property="supplierId"    column="supplier_id"    />
        <result property="payMethod"    column="pay_method"    />
        <result property="amount"    column="amount"    />
        <result property="payDate"    column="pay_date"    />
        <result property="salesman"    column="salesman"    />
        <result property="operator"    column="operator"    />
        <result property="paymentVoucherCode"    column="payment_voucher_code"    />
        <result property="approver"    column="approver"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectSysApPrepaymentVo">
        select id, code, origin_code, supplier_id, pay_method, amount, pay_date, salesman, operator, payment_voucher_code, approver, create_by, create_time, update_by, update_time, remark from sys_ap_prepayment
    </sql>

    <select id="selectSysApPrepaymentList" parameterType="SysApPrepayment" resultMap="SysApPrepaymentResult">
        <include refid="selectSysApPrepaymentVo"/>
        <where>  
            <if test="code != null  and code != ''"> and code like concat('%', #{code}, '%')</if>
            <if test="originCode != null  and originCode != ''"> and origin_code = #{originCode}</if>
            <if test="payMethod != null  and payMethod != ''"> and pay_method = #{payMethod}</if>
            <if test="amount != null "> and amount = #{amount}</if>
            <if test="payDate != null "> and pay_date = #{payDate}</if>
            <if test="salesman != null  and salesman != ''"> and salesman = #{salesman}</if>
            <if test="operator != null  and operator != ''"> and operator = #{operator}</if>
            <if test="paymentVoucherCode != null  and paymentVoucherCode != ''"> and payment_voucher_code = #{paymentVoucherCode}</if>
            <if test="approver != null  and approver != ''"> and approver = #{approver}</if>
        </where>
    </select>
    
    <select id="selectSysApPrepaymentById" parameterType="Long" resultMap="SysApPrepaymentResult">
        <include refid="selectSysApPrepaymentVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertSysApPrepayment" parameterType="SysApPrepayment" useGeneratedKeys="true" keyProperty="id">
        insert into sys_ap_prepayment
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="code != null and code != ''">code,</if>
            <if test="originCode != null">origin_code,</if>
            <if test="supplierId != null">supplier_id,</if>
            <if test="payMethod != null">pay_method,</if>
            <if test="amount != null">amount,</if>
            <if test="payDate != null">pay_date,</if>
            <if test="salesman != null">salesman,</if>
            <if test="operator != null">operator,</if>
            <if test="paymentVoucherCode != null">payment_voucher_code,</if>
            <if test="approver != null">approver,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="code != null and code != ''">#{code},</if>
            <if test="originCode != null">#{originCode},</if>
            <if test="supplierId != null">#{supplierId},</if>
            <if test="payMethod != null">#{payMethod},</if>
            <if test="amount != null">#{amount},</if>
            <if test="payDate != null">#{payDate},</if>
            <if test="salesman != null">#{salesman},</if>
            <if test="operator != null">#{operator},</if>
            <if test="paymentVoucherCode != null">#{paymentVoucherCode},</if>
            <if test="approver != null">#{approver},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateSysApPrepayment" parameterType="SysApPrepayment">
        update sys_ap_prepayment
        <trim prefix="SET" suffixOverrides=",">
            <if test="code != null and code != ''">code = #{code},</if>
            <if test="originCode != null">origin_code = #{originCode},</if>
            <if test="supplierId != null">supplier_id = #{supplierId},</if>
            <if test="payMethod != null">pay_method = #{payMethod},</if>
            <if test="amount != null">amount = #{amount},</if>
            <if test="payDate != null">pay_date = #{payDate},</if>
            <if test="salesman != null">salesman = #{salesman},</if>
            <if test="operator != null">operator = #{operator},</if>
            <if test="paymentVoucherCode != null">payment_voucher_code = #{paymentVoucherCode},</if>
            <if test="approver != null">approver = #{approver},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteSysApPrepaymentById" parameterType="Long">
        delete from sys_ap_prepayment where id = #{id}
    </delete>

    <delete id="deleteSysApPrepaymentByIds" parameterType="String">
        delete from sys_ap_prepayment where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
