<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.template.system.mapper.SysReturnLineMapper">
    
    <resultMap type="SysReturnLine" id="SysReturnLineResult">
        <result property="id"    column="id"    />
        <result property="returnId"    column="return_id"    />
        <result property="lineNo"    column="line_no"    />
        <result property="refOutboundCode"    column="ref_outbound_code"    />
        <result property="productId"    column="product_id"    />
        <result property="productCode"    column="product_code"    />
        <result property="productName"    column="product_name"    />
        <result property="spec"    column="spec"    />
        <result property="qty"    column="qty"    />
        <result property="unit"    column="unit"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectSysReturnLineVo">
        select id, return_id, line_no, ref_outbound_code, product_id, product_code, product_name, spec, qty, unit, create_by, create_time, update_by, update_time, remark from sys_return_line
    </sql>

    <select id="selectSysReturnLineList" parameterType="SysReturnLine" resultMap="SysReturnLineResult">
        <include refid="selectSysReturnLineVo"/>
        <where>  
            <if test="returnId != null "> and return_id = #{returnId}</if>
            <if test="lineNo != null "> and line_no = #{lineNo}</if>
            <if test="refOutboundCode != null  and refOutboundCode != ''"> and ref_outbound_code = #{refOutboundCode}</if>
            <if test="productId != null "> and product_id = #{productId}</if>
            <if test="productCode != null  and productCode != ''"> and product_code = #{productCode}</if>
            <if test="productName != null  and productName != ''"> and product_name like concat('%', #{productName}, '%')</if>
            <if test="spec != null  and spec != ''"> and spec = #{spec}</if>
            <if test="qty != null "> and qty = #{qty}</if>
            <if test="unit != null  and unit != ''"> and unit = #{unit}</if>
        </where>
    </select>
    
    <select id="selectSysReturnLineById" parameterType="Long" resultMap="SysReturnLineResult">
        <include refid="selectSysReturnLineVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertSysReturnLine" parameterType="SysReturnLine" useGeneratedKeys="true" keyProperty="id">
        insert into sys_return_line
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="returnId != null">return_id,</if>
            <if test="lineNo != null">line_no,</if>
            <if test="refOutboundCode != null">ref_outbound_code,</if>
            <if test="productId != null">product_id,</if>
            <if test="productCode != null">product_code,</if>
            <if test="productName != null">product_name,</if>
            <if test="spec != null">spec,</if>
            <if test="qty != null">qty,</if>
            <if test="unit != null">unit,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="returnId != null">#{returnId},</if>
            <if test="lineNo != null">#{lineNo},</if>
            <if test="refOutboundCode != null">#{refOutboundCode},</if>
            <if test="productId != null">#{productId},</if>
            <if test="productCode != null">#{productCode},</if>
            <if test="productName != null">#{productName},</if>
            <if test="spec != null">#{spec},</if>
            <if test="qty != null">#{qty},</if>
            <if test="unit != null">#{unit},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateSysReturnLine" parameterType="SysReturnLine">
        update sys_return_line
        <trim prefix="SET" suffixOverrides=",">
            <if test="returnId != null">return_id = #{returnId},</if>
            <if test="lineNo != null">line_no = #{lineNo},</if>
            <if test="refOutboundCode != null">ref_outbound_code = #{refOutboundCode},</if>
            <if test="productId != null">product_id = #{productId},</if>
            <if test="productCode != null">product_code = #{productCode},</if>
            <if test="productName != null">product_name = #{productName},</if>
            <if test="spec != null">spec = #{spec},</if>
            <if test="qty != null">qty = #{qty},</if>
            <if test="unit != null">unit = #{unit},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteSysReturnLineById" parameterType="Long">
        delete from sys_return_line where id = #{id}
    </delete>

    <delete id="deleteSysReturnLineByIds" parameterType="String">
        delete from sys_return_line where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>