<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.template.system.mapper.SysLoanReturnLineMapper">
    
    <resultMap type="SysLoanReturnLine" id="SysLoanReturnLineResult">
        <result property="id"    column="id"    />
        <result property="loanReturnId"    column="loan_return_id"    />
        <result property="lineNo"    column="line_no"    />
        <result property="loanCode"    column="loan_code"    />
        <result property="productId"    column="product_id"    />
        <result property="productCode"    column="product_code"    />
        <result property="qty"    column="qty"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectSysLoanReturnLineVo">
        select id, loan_return_id, line_no, loan_code, product_id, product_code, qty, create_by, create_time, update_by, update_time, remark from sys_loan_return_line
    </sql>

    <select id="selectSysLoanReturnLineList" parameterType="SysLoanReturnLine" resultMap="SysLoanReturnLineResult">
        <include refid="selectSysLoanReturnLineVo"/>
        <where>  
            <if test="loanReturnId != null "> and loan_return_id = #{loanReturnId}</if>
            <if test="lineNo != null "> and line_no = #{lineNo}</if>
            <if test="loanCode != null  and loanCode != ''"> and loan_code = #{loanCode}</if>
            <if test="productId != null "> and product_id = #{productId}</if>
            <if test="productCode != null  and productCode != ''"> and product_code = #{productCode}</if>
            <if test="qty != null "> and qty = #{qty}</if>
        </where>
    </select>
    
    <select id="selectSysLoanReturnLineById" parameterType="Long" resultMap="SysLoanReturnLineResult">
        <include refid="selectSysLoanReturnLineVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertSysLoanReturnLine" parameterType="SysLoanReturnLine" useGeneratedKeys="true" keyProperty="id">
        insert into sys_loan_return_line
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="loanReturnId != null">loan_return_id,</if>
            <if test="lineNo != null">line_no,</if>
            <if test="loanCode != null">loan_code,</if>
            <if test="productId != null">product_id,</if>
            <if test="productCode != null">product_code,</if>
            <if test="qty != null">qty,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="loanReturnId != null">#{loanReturnId},</if>
            <if test="lineNo != null">#{lineNo},</if>
            <if test="loanCode != null">#{loanCode},</if>
            <if test="productId != null">#{productId},</if>
            <if test="productCode != null">#{productCode},</if>
            <if test="qty != null">#{qty},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateSysLoanReturnLine" parameterType="SysLoanReturnLine">
        update sys_loan_return_line
        <trim prefix="SET" suffixOverrides=",">
            <if test="loanReturnId != null">loan_return_id = #{loanReturnId},</if>
            <if test="lineNo != null">line_no = #{lineNo},</if>
            <if test="loanCode != null">loan_code = #{loanCode},</if>
            <if test="productId != null">product_id = #{productId},</if>
            <if test="productCode != null">product_code = #{productCode},</if>
            <if test="qty != null">qty = #{qty},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteSysLoanReturnLineById" parameterType="Long">
        delete from sys_loan_return_line where id = #{id}
    </delete>

    <delete id="deleteSysLoanReturnLineByIds" parameterType="String">
        delete from sys_loan_return_line where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>