{
  "compilerOptions": {
    "noImplicitAny": false,
    "target": "esnext",
    "useDefineForClassFields": true,
    "module": "esnext",
    "moduleResolution": "node",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "allowJs":true,
    "paths": {
      "@/*": ["src/*"]
    },
    "lib": ["esnext", "dom"],
    "types": [
      "@dcloudio/types",
      "pinia-plugin-persist-uni",
      "wot-design-uni/global.d.ts",
      "node"
    ]
  },
  "exclude": [
    "node_modules",
    "./node_modules",
    "./node_modules/*",
    "./node_modules/wot-design-uni",
    "./node_modules/@types/node/index.d.ts"
  ],
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue"]
}
