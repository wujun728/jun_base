.container {
  width: 100%;
  height: 100%;
  background: #f5f6f7;
}
.container .attendance {
  padding: 10px 20px;
}
.container .attendance .attendance_content {
  margin-top: 10px;
}
.container .attendance .attendance_content .attendance_time {
  padding: 10px 0;
  font-size: 12px;
  display: flex;
  background: #ffffff;
  border-radius: 8rpx;
}
.container .attendance .attendance_content .attendance_time .attendance_morning {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
}
.container .attendance .attendance_content .attendance_time .attendance_morning .morning_state {
  margin-right: 10px;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #4CD964;
}
.container .attendance .attendance_content .attendance_time .attendance_afternoon {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
}
.container .attendance .attendance_content .attendance_time .attendance_afternoon .afternoon_state {
  margin-right: 10px;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #999999;
}
.container .attendance .attendance_content .location {
  padding: 10px;
  height: 20px;
  line-height: 20px;
  margin-top: 10px;
  background: #ffffff;
  font-size: 13px;
  border-radius: 8rpx;
}
.container .attendance .attendance_content .punsh_in {
  width: 120px;
  height: 120px;
  margin: 80px auto;
  border-radius: 50%;
  background: #007aff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.container .attendance .attendance_content .punsh_in .punsh_op {
  color: #ffffff;
  font-size: 16px;
  font-weight: bold;
}
.container .attendance .attendance_content .punsh_in .punshin_time {
  margin-top: 4px;
  color: #ffffff;
  opacity: 0.8;
}
.container .uni-calendar-item__weeks-box-circle {
  background: #4CD964;
}
.container .uni-calendar {
  justify-content: center;
  align-items: center;
}
.container .clock_time {
  color: #999999;
}

